    {
      "id": "muscle-ranged-defaults",
      "source": "full-2008",
      "pages": "B275-B276",
      "module": "equipment",
      "kind": "table",
      "status": "pending",
      "acceptance": "Skill defaults: blowpipe dexterity-6; bolas and lasso none; bow dexterity-5; cloak dexterity-5, net-4 or shield-4; crossbow dexterity-4; net cloak-5; sling dexterity-6; spear launcher dexterity-5 or thrown spear-4; thrown axe/mace and knife dexterity-4; thrown harpoon dexterity-4 or thrown spear-2; throwing star dexterity-4 or general throwing-2; thrown spear dexterity-4, spear launcher-4 or thrown harpoon-2. No-default skills must not acquire an invented attribute default.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-1",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Blowpipe toxin/drug follow-up applies only after penetration and uses the selected substance procedure; the launcher itself supplies no universal poison.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-2",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Readying requires two hands but attacking only one; validate these phases independently.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-3",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Bow/crossbow arrow or bolt costs two; blowpipe dart or lead pellet costs one tenth; sling stones are free. Use correct per-shot weight and compatibility.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-4",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Entangling implements use B411 actual ensnaring rules rather than generic injury.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-5",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Cocking lever permits twenty ready actions for a crossbow/prodd up to four strength above the user. Preserve setup/standing requirements from B270.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-6",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Net ranges have no half-damage threshold. Large-net maximum is strength/2 plus skill/5; combat-net maximum strength plus skill/5. Define fractional-yard handling explicitly.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-7",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Stone projectiles are technology zero, lead pellets technology two; lead adds one damage and doubles range. The printed base sling row plus this note must be resolved without applying the lead bonus twice.",
      "tests": []
    },
    {
      "id": "muscle-ranged-note-8",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Tethered harpoon removal takes a ready action and successful strength; failure permits retry next turn. Removal causes half the original entry damage. Retain entry injury and attachment identity, not current weapon damage.",
      "tests": []
    },
    {
      "id": "muscle-ranged-launcher-components",
      "source": "full-2008",
      "pages": "B276",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Spear-launcher body and its projectile have separate costs/masses. The javelin projectile is the same physical javelin available for melee/thrown use. Attack profile comes from projectile row plus launcher mechanism; loading does not merge or duplicate ownership.",
      "tests": []
    },
    {
      "id": "muscle-ranged-blade-defaults",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Muscle-powered cutting/impaling tips default to stone at technology zero, bronze one, iron two and steel three-plus. Wooden stakes and powered cutting tools are excluded. Item availability still applies; outdated materials usually use cheap-quality pricing.",
      "tests": []
    },
    {
      "id": "muscle-ranged-stone",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "table-row",
      "status": "pending",
      "acceptance": "Stone blades use armor divisor one half on cutting/impaling, receive no fine-quality damage bonus and count as cheap for breakage against swung metal/advanced weapons regardless of actual quality.",
      "tests": []
    },
    {
      "id": "muscle-ranged-volcanic-glass",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "table-row",
      "status": "pending",
      "acceptance": "Volcanic-glass blade at technology one is an ordinary-quality stone blade with cutting/impaling +1 and breakage +2. It permanently loses its extra damage after parrying a weapon, but not an unarmed attack, or striking protection two or more. Own sharpness state and retain stone armor divisor.",
      "tests": []
    },
    {
      "id": "muscle-ranged-bronze-iron",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "table-row",
      "status": "pending",
      "acceptance": "Bronze and iron blades receive no fine-quality damage bonus. Against swung superior-material weapons, treat them as cheap for breakage regardless of actual quality. Author defines material ordering for unusual substances.",
      "tests": []
    },
    {
      "id": "muscle-ranged-steel",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "table-row",
      "status": "pending",
      "acceptance": "Steel at technology three is the baseline blade material with ordinary quality/breakage rules. Do not add a separate steel damage bonus.",
      "tests": []
    },
    {
      "id": "muscle-ranged-composite-material",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "table-row",
      "status": "pending",
      "acceptance": "Advanced nonmetallic material at technology seven halves weight and doubles price. Blades cannot exceed ordinary quality, while crushing weapons use normal grades. Treat material as steel for breakage, using its reduced actual weight; metal detectors cannot detect the nonmetallic weapon itself.",
      "tests": []
    },
    {
      "id": "muscle-ranged-silver-cost",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "table-row",
      "status": "pending",
      "acceptance": "Solid silver melee weapons/arrowheads cost twenty times list and break as cheap; silver coating/edges cost three times and retain underlying breakage properties. Solid silver firearm projectiles require technology four-plus and cost fifty times list. Preserve special-order availability and underlying weapon identity.",
      "tests": []
    },
    {
      "id": "muscle-ranged-silver-vulnerability",
      "source": "full-2008",
      "pages": "B275",
      "module": "equipment",
      "kind": "table-row",
      "status": "pending",
      "acceptance": "Silver gives extra injury only against an actual silver vulnerability. Coated/edged weapons reduce its multiplier: two becomes one-and-a-half, three becomes two, four becomes three. This changes the vulnerability multiplier, not ordinary weapon damage or every target resistance.",
