    {
      "id": "object-durability-weight-selection",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Use empty weight and the lower listed weight when between table thresholds. Distinguish complex machinery from objects without complex internal structure. Values outside the printed table need an explicit formula option or authored definition.",
      "tests": []
    },
    {
      "id": "object-durability-formula",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Optional calculated capacity is ceil(4*cuberoot(empty pounds)) for machinery and ceil(8*cuberoot(empty pounds)) for uniform/dispersed objects. This is a selected alternative to lookup, not a silent extrapolation or replacement.",
      "tests": []
    },
    {
      "id": "object-durability-authored-capacity",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "author-decision",
      "status": "pending",
      "acceptance": "An author may define exceptional toughness or frailty. Record the approved capacity and reason on the object definition before play; reject absent/invalid definitions without spending resources.",
      "tests": []
    },
