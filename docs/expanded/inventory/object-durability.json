    {
      "id": "object-durability-structure-defaults",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Listed structures use uniform injury treatment and reliability 12 when in good repair. Capacity and armor are separate from material flags and failure procedures.",
      "tests": []
    },
    {
      "id": "object-durability-building-formula",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Optional building capacity is 100*cuberoot(empty tons). The paragraph gives no explicit rounding rule; resolve this before implementation. Typical mass per 1000 square feet is 50 tons for wood-frame/mud-brick, 100 for steel-frame/brick, and 150 for stone.",
      "tests": []
    },
    {
      "id": "object-durability-panel-area",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Door and wall values apply to a one-hex or ten-square-foot section, not an entire building. Keep distinct section identities for damage, breach and cover.",
      "tests": []
    },
    {
      "id": "object-durability-no-crushing",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "The resilient cable/rope flag prevents destruction by crushing. It does not grant universal damage immunity or erase other accumulated damage.",
      "tests": []
    },
    {
      "id": "object-durability-material-flags",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Combustible and brittle entries require their underlying fragility procedures; flags alone do not implement ignition, burning or breakage.",
      "tests": []
    },
    {
      "id": "object-durability-localized-erosion",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "For starred material entries, repeated attacks against the same spot of size zero or smaller erode local armor: impaling, ordinary piercing and large piercing use semi-ablative behavior; burning, corrosion, crushing, cutting and huge piercing use ablative behavior. Small piercing is not listed; keep its handling unresolved until cross-reference review. Use B46 definitions and preserve spot identity.",
      "tests": []
    },
    {
      "id": "object-durability-erosion-floor",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Localized erosion retains at least DR 1 for wood and DR 3 for brick, concrete and stone. The wallboard entry is starred without an explicit floor; require a documented resolution rather than assuming wood.",
      "tests": []
    },
    {
      "id": "object-durability-cover-separation",
      "source": "full-2008",
      "pages": "B557-B559",
      "module": "technology",
      "kind": "procedure",
      "status": "pending",
      "acceptance": "Cover DR per inch differs from the object\u2019s own armor. Use actual thickness and a selected value within the material range; integrate B407 penetration before marking complete.",
      "tests": []
    },
